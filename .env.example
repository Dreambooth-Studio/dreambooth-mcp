# Copy to .env and fill in. .env is gitignored — keep it that way.

# Studio origin. Leave as-is unless you are pointing at a preview deployment.
DREAMBOOTH_API_URL=https://dreamboothstudio.com

# PHASE 0 ONLY — your own NextAuth session token.
#
# How to get it: sign in to dreamboothstudio.com, open DevTools →
# Application → Cookies, and copy the value of the session token cookie.
#
# This is session-equivalent: one year, no scopes, no revocation. Treat it like
# a password. Phase 1 removes this entirely — the operator authorises in their
# own browser via the device flow and no token is ever pasted anywhere.
DREAMBOOTH_TOKEN=

# Per-request ceiling for calls to the Studio.
REQUEST_TIMEOUT_MS=15000
