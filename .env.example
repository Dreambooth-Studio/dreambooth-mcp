# Copy to .env and adjust. .env is gitignored — keep it that way.
#
# There is no token here, by design. Every session signs in through the
# connect_account tool and the Studio's device flow, so the credential exists
# only in memory for the life of that session and is never written to disk or
# shared between people.

# Studio origin. Leave as-is unless you are pointing at a preview deployment
# or a local dev server (e.g. http://localhost:3010).
DREAMBOOTH_API_URL=https://dreamboothstudio.com

# HTTP mode only. Railway injects PORT; this is the local fallback.
PORT=8080

# Comma-separated hostnames the transport will answer to (DNS-rebinding
# protection). Leave empty locally; set it to the public hostname in production,
# e.g. mcp.dreamboothstudio.com
ALLOWED_HOSTS=

# Per-request ceiling for calls to the Studio.
REQUEST_TIMEOUT_MS=15000

# Registers `session_info`, the connection diagnostic. Accepts 1 / true / yes;
# anything else, including empty, leaves it off.
#
# Keep it OFF in production. A directory listing is judged on its tool list, and
# this tool answers nothing an operator asked. Turn it on only to run the
# session-reuse test (docs/apps-sdk-widgets-plan.md §2.1) — ask three questions
# in ChatGPT developer mode, compare the sessionId each time, then unset it.
MCP_DIAGNOSTICS=
