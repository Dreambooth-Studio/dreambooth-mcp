# Copy to .env and fill in. .env is gitignored — keep it that way.

# Studio origin. Leave as-is unless you are pointing at a preview deployment
# or a local dev server (e.g. http://localhost:3010).
DREAMBOOTH_API_URL=https://dreamboothstudio.com

# HTTP mode only. Railway injects PORT; this is the local fallback.
PORT=8080

# stdio mode only — your own NextAuth session token, for local development.
#
# Leave EMPTY in HTTP mode. Over HTTP every session starts unauthenticated and
# the operator connects through the device flow, so no token is ever pasted
# into a config file or shared between people.
#
# When set, this is session-equivalent: one year, no scopes, no revocation.
# Treat it like a password.
DREAMBOOTH_TOKEN=

# Comma-separated hostnames the transport will answer to (DNS-rebinding
# protection). Leave empty locally; set it to the public hostname in production,
# e.g. mcp.dreamboothstudio.com
ALLOWED_HOSTS=

# Per-request ceiling for calls to the Studio.
REQUEST_TIMEOUT_MS=15000
