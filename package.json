{
  "name": "dreambooth-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Dreambooth Studio — lets ChatGPT, Claude and Gemini answer questions about an operator's booths.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts --http",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js --http",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "inspect": "tsx scripts/smoke.ts",
    "inspect:http": "tsx scripts/smoke-http.ts",
    "preview": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
