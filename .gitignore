node_modules/
dist/

# NEVER commit this. dreambooth-whatsapp deliberately commits its .env with live
# credentials; do not copy that habit here — the token in this file belongs to an
# operator's Dreambooth account and is session-equivalent.
.env
.env.*
!.env.example

*.log
.DS_Store

# MCP Registry namespace signing key. Whoever holds this can publish any server
# under com.dreamboothstudio/* — and registry entries cannot be unpublished.
# This repo is public; a committed key.pem is a permanent namespace takeover.
key.pem

# mcp-publisher's own artefacts: the downloaded binary and the registry JWT it
# caches in the working directory after `login`.
mcp-publisher.exe
.mcpregistry_token

.preview/

# Built skill archives for the ChatGPT submission portal. Regenerate rather
# than commit: the sources are in chatgpt-skills/.
dist-skills/

# Skill archives built for upload, including ones zipped by hand.
chatgpt-skills/*.zip

# Submission screenshots, rendered from .preview by headless Chrome. Build
# output like .preview itself — regenerate with npm run preview and the
# render step rather than committing PNGs.
#
# The scripts that BUILD them are tracked, though. Ignoring them too is how the
# 706x860 sizing rule and the scale-to-fit fix ended up living only in a session
# scratchpad, which is how the v2.0.0 screenshots were rejected twice for the
# same reason. Images, captured responses and source assets stay out.
.screenshots/**
!.screenshots/README.md
!.screenshots/build/
!.screenshots/build/*.ts
!.screenshots/build/*.js

# ChatGPT app submission: the generated import file and the portal's exports.
# The exports carry the reviewer account's credentials; the import file is
# rebuilt from docs/submission/build_submission_import.py.
chatgpt-app-submission.json
dreambooth-studio-*.json
