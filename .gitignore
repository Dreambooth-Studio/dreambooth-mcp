node_modules/
dist/

# NEVER commit this. dreambooth-whatsapp deliberately commits its .env with live
# credentials; do not copy that habit here — the token in this file belongs to an
# operator's Dreambooth account and is session-equivalent.
.env
.env.*
!.env.example

*.log
.DS_Store

# MCP Registry namespace signing key. Whoever holds this can publish any server
# under com.dreamboothstudio/* — and registry entries cannot be unpublished.
# This repo is public; a committed key.pem is a permanent namespace takeover.
key.pem

# mcp-publisher's own artefacts: the downloaded binary and the registry JWT it
# caches in the working directory after `login`.
mcp-publisher.exe
.mcpregistry_token

