{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The repo root, not "." and not the inherited "src". These scripts live in
    // scripts/ but import from src/ — preview.ts pulls in src/ui — so the root
    // has to span both. Nothing is emitted here, so rootDir only ever decides
    // which files tsc is willing to admit to the program.
    "rootDir": "..",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
